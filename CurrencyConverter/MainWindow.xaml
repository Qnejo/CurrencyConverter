<Window x:Class="CurrencyConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конвертер валют" Height="450" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Конвертер валют" FontSize="20" 
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Сумма:" FontWeight="Bold" Padding="0, 5"/>
            <TextBox x:Name="InputAmountTextBox" FontSize="16" Padding="5"/>
        </StackPanel>
        
        <Grid Grid.Row="2" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Из какой валюты -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Из валюты:" FontWeight="Bold" Padding="0, 5"/>
                <ComboBox x:Name="FromCurrencyComboBox" Height="32" FontSize="14" Padding="5" 
                          SelectedIndex="0"/>
            </StackPanel>
            
            <Button Grid.Column="1" Content="REV" Width="32" Height="32" VerticalAlignment="Bottom" Click="ReverseCurrencyCode"/>
            
            <!-- В какую валюту -->
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="В валюту:" FontWeight="Bold" Padding="0, 5"/>
                <ComboBox x:Name="ToCurrencyComboBox" Height="32" FontSize="14" Padding="5" 
                          SelectedIndex="1"/>
            </StackPanel>
        </Grid>
        
        <Button Grid.Row="3" x:Name="ConvertButton" Content="Конвертировать" 
                FontSize="16" FontWeight="Bold" Padding="10" Margin="0,15" Click="ConvertButton_Click" />
        
        <Border Grid.Row="4" Background="LightGray" Padding="10" 
                VerticalAlignment="Stretch">
            <TextBlock x:Name="ResultTextBlock" FontSize="18" FontWeight="Bold" 
                       TextWrapping="Wrap"/>
        </Border>

    </Grid>
</Window>